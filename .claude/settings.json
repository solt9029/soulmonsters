{
  "permissions": {
    "deny": [
      "Read(client/.env)",
      "Read(server/.env)",
      "Read(deploy/.env)",
      "Read(client/.env.production)",
      "Read(server/.env.production)",
      "Read(deploy/.env.production)"
    ],
    "allow": [
      "Bash(mkdir:*)",
      "Bash(yarn format)",
      "Bash(yarn test)",
      "Bash(yarn build)",
      "Bash(yarn workspace soulmonsters-server test)",
      "Bash(yarn workspace soulmonsters-server format)",
      "Bash(yarn workspace soulmonsters-server test:*)",
      "Bash(yarn workspace soulmonsters-server format:*)",
      "Bash(cd:*)",
      "Bash(yarn generate-graphql-types)",
      "Bash(yarn workspace soulmonsters-server build)",
      "Bash(yarn workspace soulmonsters-client build)"
    ]
  }
}
